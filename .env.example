# ─────────────────────────────────────────────────────────────
# AutoCost — variables d'environnement
# Copier ce fichier en `.env` puis adapter les valeurs.
# Seules les variables préfixées VITE_ sont exposées au navigateur :
# n'y placer AUCUN secret, clé privée ou identifiant.
# ─────────────────────────────────────────────────────────────

# Source de données utilisée par l'application.
#   mock → jeu de données de démonstration + calcul local (aucun réseau)
#   rest → API distante respectant le contrat /vehicules et /simulation
VITE_DATA_SOURCE=mock

# Base de l'API REST. Obligatoire si VITE_DATA_SOURCE=rest.
# Sans slash final. Exemple : https://mon-api.exemple.com/api
VITE_API_URL=

# Délai maximal d'une requête, en millisecondes (défaut : 12000).
VITE_API_TIMEOUT=12000
